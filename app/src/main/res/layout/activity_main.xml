<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/screen_bg"
    tools:context="com.stupendous.jumbledwords.MainActivity">

    <pl.droidsonroids.gif.GifImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/logo"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:layout_margin="20dp"
        android:src="@drawable/jumble_word" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/blue"
        android:layout_margin="20dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:text="JUMBLED\nWORDS" />

    <TextView
        android:id="@+id/tv_totalScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/blue"
        android:textStyle="bold"
        android:layout_margin="20dp"
        android:textSize="@dimen/textsize_22sp"
        android:gravity="center"
        android:layout_below="@id/logo"
        android:layout_centerHorizontal="true"
        android:text="@string/best_score" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="447dp"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/logo"
            android:layout_centerHorizontal="true"
            android:layout_margin="20dp"
            android:gravity="center"
            android:text="@string/select_a_level_to_start_game"
            android:textColor="@color/blue"
            android:textSize="@dimen/textsize_18sp" />

        <pl.droidsonroids.gif.GifImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_margin="20dp"
            android:gravity="center"
            android:src="@drawable/arrow" />

        <com.stupendous.jumbledwords.utils.VariableGravityButton
            android:id="@+id/btnLevel1"
            android:layout_width="181dp"
            android:layout_height="67dp"
            android:layout_below="@id/tv_totalScore"
            android:layout_centerHorizontal="true"
            android:background="@drawable/easy_cloud"
            android:paddingLeft="15dp"
            android:paddingTop="10dp"
            android:paddingRight="15dp"
            android:paddingBottom="10dp"
            android:text="@string/level1"
            android:textColor="@color/white" />

        <com.stupendous.jumbledwords.utils.VariableGravityButton
            android:id="@+id/btnLevel2"
            android:layout_width="185dp"
            android:layout_height="62dp"
            android:layout_below="@id/tv_totalScore"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:background="@drawable/cloud"
            android:paddingLeft="15dp"
            android:paddingTop="10dp"
            android:paddingRight="15dp"
            android:paddingBottom="10dp"
            android:text="@string/level2"
            android:textColor="@color/white" />

        <com.stupendous.jumbledwords.utils.VariableGravityButton
            android:id="@+id/btnLevel3"
            android:layout_width="200dp"
            android:layout_height="69dp"
            android:layout_below="@id/tv_totalScore"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:background="@drawable/cloud"
            android:paddingLeft="15dp"
            android:paddingTop="10dp"
            android:paddingRight="15dp"
            android:paddingBottom="10dp"
            android:text="@string/level3"
            android:textColor="@color/white" />

    </LinearLayout>

    <RelativeLayout
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_quitGame"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentLeft="true"
            android:tint="@color/blue"
            android:visibility="gone"
            android:layout_centerVertical="true"
            android:src="@drawable/home"/>

       <!-- <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:padding="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_startGame"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:tint="#008000"
            android:src="@drawable/start"/>

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue"

            android:textSize="18sp"
            android:layout_below="@+id/iv_startGame"
            android:layout_centerInParent="true"
            android:layout_alignBottom="@+id/iv_startGame"
            android:gravity="center"
            android:text="Start" />
        </LinearLayout>-->
    </RelativeLayout>


    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        ads:adSize="BANNER"
        ads:adUnitId="@string/ad_banner">

    </com.google.android.gms.ads.AdView>
</RelativeLayout>
